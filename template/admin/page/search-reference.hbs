<style>
  .ts-control {
    padding-left: 0px;
    border-width: 0px;
    flex-wrap: nowrap;
    input {
      font-size: 14px;
      color: inherit;
    }
  }
  .ts-control,
  .ts-wrapper.single.input-active .ts-control,
  .full .ts-control,
  .ts-dropdown,
  .ts-dropdown .active {
    background: inherit;
    border-color: inherit;
    color: inherit;
  }
  .ts-dropdown .active {
    background: var(--color-secondary-content);
  }
  .has-items .ts-control > input {
    margin-left: 0px !important;
  }
</style>
<dialog class="modal modal-open" id="search-reference">
  <div class="modal-box max-w-2xl">
    <form id="set-reference-form" onsubmit="event.preventDefault();">
      <h3 class="font-bold text-lg mb-4">Search {{type}} reference</h3>
      {{#if type}}
        <div class="form-control mb-4">
          <label class="label" for="page">{{type}}</label>
          <span class="text-error">*</span>
          <select
            id="select-ref"
            name="page"
            placeholder="Select {{type}}..."
            autocomplete="off"
            class="input input-bordered w-full text-base-content"
          >
            <option value=""></option>
            {{#each refs}}
              <option
                value="{{identifier}}"
                data-enabled="{{isEnabled}}"
                {{compareAndUse "selected" true selectedID identifier}}
              >{{secondaryIdentifierValue}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-control mb-4">
          <label class="label" for="link-text">link text</label>
          <input
            type="text"
            name="link-text"
            class="input input-bordered w-full"
            value="{{linkText}}"
          />
        </div>
        <div class="form-control mb-4">
          <label class="label" for="alt-text">alt text</label>
          <input
            type="text"
            name="alt-text"
            class="input input-bordered w-full"
            value="{{altText}}"
          />
        </div>
      {{else}}
        <div class="form-control mb-4">
          <label class="label" for="page">Type</label>
          <select
            id="select-ref-type"
            placeholder="Select type..."
            autocomplete="off"
            class="input input-bordered w-full text-base-content"
          >
            <option value=""></option>
            {{#each types}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}
      <div class="modal-action">
        {{#if type}}
          <button class="btn btn-success" onclick="setReference('{{type}}')">
            {{#if selectedID}}
              <i class="fas fa-floppy-disk"></i>Update
            {{else}}
              <i class="fas fa-circle-plus"></i>
              Create
            {{/if}}
          </button>
        {{else}}
          <button class="btn btn-success" onclick="setReferenceType()">
            <i class="fas fa-circle-dot"></i>Select
          </button>
        {{/if}}
        <button
          type="button"
          class="btn btn-error"
          onclick="closeSearchReferenceModal()"
        >
          <i class="fas fa-circle-xmark"></i>
          Cancel
        </button>
      </div>
    </form>
  </div>
</dialog>
<script defer>initTypeSelect();</script>
